# ============================================================
# DevBhumi — Environment Configuration Template
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# ============================================================

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devbhumi
POSTGRES_USER=devbhumi_admin
POSTGRES_PASSWORD=change_me_strong_password

# Per-service restricted DB users (created via database/seeds/init_db_users.sh
# on first Postgres startup — see that file). Each *_DATABASE_URL password
# MUST match the corresponding *_DB_PASSWORD below exactly.
AUTH_DB_PASSWORD=change_me_auth_password
AUTH_DATABASE_URL=postgresql://auth_svc:change_me_auth_password@postgres:5432/devbhumi

TRAFFIC_DB_PASSWORD=change_me_traffic_password
TRAFFIC_DATABASE_URL=postgresql://traffic_svc:change_me_traffic_password@postgres:5432/devbhumi

COMPLAINT_DB_PASSWORD=change_me_complaint_password
COMPLAINT_DATABASE_URL=postgresql://complaint_svc:change_me_complaint_password@postgres:5432/devbhumi

ALERT_DB_PASSWORD=change_me_alert_password
ALERT_DATABASE_URL=postgresql://alert_svc:change_me_alert_password@postgres:5432/devbhumi

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- JWT (RS256 — asymmetric keys) ----------
# Generate with scripts/generate_jwt_keys.sh — never use a shared HS256 secret
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=devbhumi-auth-service

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- MinIO (local S3-compatible storage for complaint images) ----------
MINIO_ROOT_USER=devbhumi_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ---------- S3 / Object storage (complaint-service) ----------
# Leave S3_ENDPOINT_URL set to MinIO for local/dev. For real AWS S3 in
# production, clear S3_ENDPOINT_URL and set real AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY instead of reusing the MinIO credentials.
S3_BUCKET_NAME=devbhumi-complaint-media
S3_ENDPOINT_URL=http://minio:9000
AWS_REGION=ap-south-1
USE_OCR=true

# ---------- Alert service ----------
ALERT_RADIUS_KM=2.0
USE_FCM=false
FCM_CREDENTIALS_PATH=

# ---------- Service ports (host machine) ----------
AUTH_SERVICE_PORT=8001
TRAFFIC_SERVICE_PORT=8002
COMPLAINT_SERVICE_PORT=8003
ALERT_SERVICE_PORT=8004
ML_SERVICE_PORT=8005

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost/api/v1

# Browser-accessible storage endpoint; use your HTTPS storage domain when hosted.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
